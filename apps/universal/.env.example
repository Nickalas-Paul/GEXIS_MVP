# Expo loads env from apps/universal/ (copy to .env and set your token)
EXPO_PUBLIC_MAPBOX_TOKEN=your-mapbox-token-here

# API base URL. Use LAN IP for physical-device / native testing.
# Web can use localhost or the same LAN IP.
EXPO_PUBLIC_API_URL=http://localhost:3001

# Optional: if EXPO_PUBLIC_API_URL is localhost, native will fall back to this.
# EXPO_PUBLIC_API_URL_LAN=http://192.168.1.139:3001

# Feature gating (Phase 6). Shared with API; false = all unlocked (beta).
GEXIS_GATING_ENABLED=false
